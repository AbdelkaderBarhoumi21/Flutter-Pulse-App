# Copy to .env and run with:  flutter run --dart-define-from-file=.env
# Values are compiled in at build time - never put secrets here.

# Base URL of the task_api backend (10.0.2.2 = host machine from the Android emulator)
API_BASE_URL=http://10.0.2.2:3000

# Log HTTP requests/responses to the console (ignored in release builds)
ENABLE_HTTP_LOGS=true
